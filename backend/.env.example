# ─── Required ────────────────────────────────────────────────────────────────
# Get your FREE Gemini API key at https://aistudio.google.com/app/apikey
# (Never commit a real key — this file ships to everyone who clones the repo.)
GEMINI_API_KEY=

# ─── Optional overrides ───────────────────────────────────────────────────────
# Gemini 2.5 Flash supports Google-Search grounding (used for real data discovery)
GEMINI_MODEL=gemini-2.5-flash

DATABASE_URL=sqlite:///tradehub.db

# Gmail OAuth2 credentials (download from Google Cloud Console)
# See README.md for setup instructions
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# Discovery / scraping settings
SCRAPE_DELAY_SECONDS=1.5
REQUEST_TIMEOUT=30
MAX_EVENTS_PER_SOURCE=20
MAX_LEADS_PER_EVENT=50

# Base URL used for email open-tracking pixels. For real outreach this must be
# reachable from the recipient's mail client (use a tunnel or hosted domain).
TRACKING_BASE_URL=http://localhost:8000

# CORS – space-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
